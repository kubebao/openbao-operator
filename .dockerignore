# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum
!vendor/
!vendor/**
!vendor/modules.txt

# Re-include embedded trusted root JSON file for keyless verification
!internal/adapter/security/trusted_root.json

# Re-include the embedded release admission policy contracts
!internal/platform/admission/zz_generated.contracts.json

# Re-include embedded trusted root JSON file for keyless verification
!internal/adapter/security/trusted_root.json

# Re-include compiled Linux binaries for fast builds (excludes local mac/others)
!bin/linux_amd64/

# Devenv keeps an internal Go module cache under the repository root. Keep it
# excluded even though the Go source rule above re-includes nested *.go files.
.devenv/
