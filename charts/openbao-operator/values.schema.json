{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenBao Operator Helm Chart Values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Global values shared by parent charts and subcharts"
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full name of resources"
    },
    "platform": {
      "type": "string",
      "description": "Target platform configuration (auto, kubernetes, openshift)",
      "enum": [
        "auto",
        "kubernetes",
        "openshift"
      ],
      "default": "auto"
    },
    "image": {
      "type": "object",
      "description": "Operator image configuration",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "description": "Image repository for the operator manager",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "Image tag. Defaults to Chart.appVersion if not set"
        },
        "digest": {
          "type": "string",
          "description": "Image digest. If set, takes precedence over tag"
        },
        "pullPolicy": {
          "type": "string",
          "description": "Image pull policy",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "pullPolicy"
      ]
    },
    "helperImages": {
      "type": "object",
      "description": "Complete default helper image references",
      "additionalProperties": false,
      "properties": {
        "init": {
          "type": "string"
        },
        "backup": {
          "type": "string"
        },
        "upgrade": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "Image pull secrets for operator images",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "operatorVersion": {
      "type": "string",
      "description": "Override operator version reported in status"
    },
    "tenancy": {
      "type": "object",
      "description": "Tenancy mode configuration",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "description": "Tenancy mode: multi (deploys controller + provisioner) or single (controller only)",
          "enum": [
            "multi",
            "single"
          ],
          "default": "multi"
        },
        "targetNamespace": {
          "type": "string",
          "description": "Target namespace for single-tenant mode"
        },
        "namespacePodSecurityLabels": {
          "type": "object",
          "description": "Tenant namespace Pod Security label management",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "description": "Tenant namespace Pod Security label ownership. enforce lets the provisioner apply restricted labels; external delegates labels to the platform policy layer.",
              "enum": [
                "enforce",
                "external"
              ],
              "default": "enforce"
            }
          },
          "required": [
            "mode"
          ]
        }
      },
      "required": [
        "mode"
      ]
    },
    "controller": {
      "type": "object",
      "description": "Controller deployment configuration",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "description": "Number of controller replicas",
          "minimum": 1,
          "default": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "extraEnv": {
          "$ref": "#/$defs/envVars"
        },
        "extraArgs": {
          "type": "array",
          "description": "Additional arguments for the controller manager",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "nodeSelector": {
          "$ref": "#/$defs/nodeSelector"
        },
        "tolerations": {
          "$ref": "#/$defs/tolerations"
        },
        "affinity": {
          "$ref": "#/$defs/affinity"
        },
        "podAnnotations": {
          "$ref": "#/$defs/annotations"
        },
        "podLabels": {
          "$ref": "#/$defs/labels"
        },
        "securityContext": {
          "$ref": "#/$defs/containerSecurityContext"
        },
        "podSecurityContext": {
          "$ref": "#/$defs/podSecurityContext"
        },
        "serviceAccount": {
          "$ref": "#/$defs/serviceAccount"
        }
      }
    },
    "provisioner": {
      "type": "object",
      "description": "Provisioner deployment configuration (only used when tenancy.mode=multi)",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "description": "Number of provisioner replicas",
          "minimum": 1,
          "default": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "extraEnv": {
          "$ref": "#/$defs/envVars"
        },
        "extraArgs": {
          "type": "array",
          "description": "Additional arguments for the provisioner manager",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "nodeSelector": {
          "$ref": "#/$defs/nodeSelector"
        },
        "tolerations": {
          "$ref": "#/$defs/tolerations"
        },
        "affinity": {
          "$ref": "#/$defs/affinity"
        },
        "podAnnotations": {
          "$ref": "#/$defs/annotations"
        },
        "podLabels": {
          "$ref": "#/$defs/labels"
        },
        "securityContext": {
          "$ref": "#/$defs/containerSecurityContext"
        },
        "podSecurityContext": {
          "$ref": "#/$defs/podSecurityContext"
        },
        "serviceAccount": {
          "$ref": "#/$defs/serviceAccount"
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Metrics configuration",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable metrics endpoints",
          "default": true
        },
        "port": {
          "type": "integer",
          "description": "Metrics port",
          "minimum": 1,
          "maximum": 65535,
          "default": 8443
        },
        "rbac": {
          "type": "object",
          "description": "Optional RBAC to allow external scrapers (Prometheus/vmagent) to GET /metrics",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Create a ClusterRoleBinding to the built-in metrics-reader ClusterRole",
              "default": false
            },
            "subjects": {
              "type": "array",
              "description": "Subjects (ServiceAccounts) that should be allowed to scrape metrics",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "namespace"
                ]
              },
              "default": []
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "description": "Prometheus Operator ServiceMonitor configuration",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable ServiceMonitor resources for controller/provisioner metrics",
              "default": false
            },
            "namespace": {
              "type": "string",
              "description": "Namespace to create ServiceMonitors in (defaults to release namespace if empty)"
            },
            "interval": {
              "type": "string",
              "description": "Scrape interval",
              "default": "30s"
            },
            "scrapeTimeout": {
              "type": "string",
              "description": "Scrape timeout",
              "default": "10s"
            },
            "labels": {
              "type": "object",
              "description": "Additional labels to add to the ServiceMonitor",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            },
            "tlsConfig": {
              "type": "object",
              "description": "TLS config for scraping the secure metrics endpoint",
              "additionalProperties": false,
              "properties": {
                "insecureSkipVerify": {
                  "type": "boolean",
                  "description": "Skip TLS verification (useful with self-signed certs). Set to false and configure secrets for strict verification.",
                  "default": true
                },
                "serverName": {
                  "type": "string",
                  "description": "Optional serverName override, e.g. openbao-operator-controller-metrics.<ns>.svc",
                  "default": ""
                },
                "caSecret": {
                  "type": "object",
                  "description": "Optional CA secret reference",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "default": ""
                    },
                    "key": {
                      "type": "string",
                      "default": "ca.crt"
                    }
                  }
                },
                "certSecret": {
                  "type": "object",
                  "description": "Optional client cert secret reference",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "default": ""
                    },
                    "key": {
                      "type": "string",
                      "default": "tls.crt"
                    }
                  }
                },
                "keySecret": {
                  "type": "object",
                  "description": "Optional client key secret reference",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "default": ""
                    },
                    "key": {
                      "type": "string",
                      "default": "tls.key"
                    }
                  }
                }
              }
            }
          }
        },
        "victoriaMetrics": {
          "type": "object",
          "description": "VictoriaMetrics Operator (VMServiceScrape) configuration",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable VMServiceScrape resources for controller/provisioner metrics",
              "default": false
            },
            "namespace": {
              "type": "string",
              "description": "Namespace to create VMServiceScrapes in (defaults to release namespace if empty)"
            },
            "interval": {
              "type": "string",
              "description": "Scrape interval",
              "default": "30s"
            },
            "scrapeTimeout": {
              "type": "string",
              "description": "Scrape timeout",
              "default": "10s"
            },
            "labels": {
              "type": "object",
              "description": "Additional labels to add to the VMServiceScrape",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            },
            "tlsConfig": {
              "type": "object",
              "description": "TLS config for scraping the secure metrics endpoint",
              "additionalProperties": false,
              "properties": {
                "insecureSkipVerify": {
                  "type": "boolean",
                  "description": "Skip TLS verification (useful with self-signed certs). Set to false and configure trusted CA in your scraping stack for strict verification.",
                  "default": true
                },
                "serverName": {
                  "type": "string",
                  "description": "Optional serverName override, e.g. openbao-operator-controller-metrics.<ns>.svc",
                  "default": ""
                }
              }
            }
          }
        }
      }
    },
    "leaderElection": {
      "type": "object",
      "description": "Leader election configuration",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable leader election for HA deployments",
          "default": true
        }
      }
    },
    "healthProbes": {
      "type": "object",
      "description": "Health probe configuration",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "description": "Port for health probes",
          "minimum": 1,
          "maximum": 65535,
          "default": 8081
        },
        "livenessInitialDelaySeconds": {
          "type": "integer",
          "description": "Liveness probe initial delay",
          "minimum": 0,
          "default": 15
        },
        "livenessPeriodSeconds": {
          "type": "integer",
          "description": "Liveness probe period",
          "minimum": 1,
          "default": 20
        },
        "readinessInitialDelaySeconds": {
          "type": "integer",
          "description": "Readiness probe initial delay",
          "minimum": 0,
          "default": 5
        },
        "readinessPeriodSeconds": {
          "type": "integer",
          "description": "Readiness probe period",
          "minimum": 1,
          "default": 10
        }
      }
    },
    "admissionPolicies": {
      "type": "object",
      "description": "ValidatingAdmissionPolicy configuration",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable ValidatingAdmissionPolicies for resource protection. Setting this to false is treated as UNSAFE MODE (operator runs without admission guardrails).",
          "default": true
        },
        "pvcBindingSync": {
          "type": "object",
          "description": "Platform-managed allowance for constrained PVC binding synchronization",
          "additionalProperties": false,
          "properties": {
            "allowedCallers": {
              "type": "array",
              "default": [],
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["username", "namespaces"],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^*\\r\\n]+$"
                  },
                  "namespaces": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "maxLength": 63,
                      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                    }
                  }
                }
              }
            }
          },
          "required": ["allowedCallers"]
        },
        "podMetadataSync": {
          "type": "object",
          "description": "Platform-managed allowance for exact annotation keys on managed workload Pods",
          "additionalProperties": false,
          "properties": {
            "allowedCallers": {
              "type": "array",
              "default": [],
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "username",
                  "namespaces",
                  "annotationKeys"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^*\\r\\n]+$"
                  },
                  "namespaces": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "maxLength": 63,
                      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                    }
                  },
                  "annotationKeys": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 317,
                      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
                      "not": {
                        "anyOf": [
                          {
                            "pattern": "^openbao\\.org/"
                          },
                          {
                            "pattern": "^vcluster\\.loft\\.sh/"
                          },
                          {
                            "pattern": "(^|\\.)(kubernetes\\.io|k8s\\.io)/"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "required": ["allowedCallers"]
        },
        "maintenanceBreakGlassGroups": {
          "type": "array",
          "description": "Deprecated and no longer used. Maintenance authorization now comes from Kubernetes RBAC via the custom `maintenance` verb on `openbaoclusters.openbao.org`.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "system:masters"
          ]
        },
        "provisionerRBAC": {
          "type": "object",
          "description": "Provisioner RBAC ValidatingAdmissionPolicy configuration (multi-tenant mode)",
          "additionalProperties": false,
          "properties": {
            "deniedNamespaces": {
              "type": "array",
              "description": "Exact namespace names where the Provisioner may not manage tenant RBAC (release namespace is always denied)",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "openshift"
              ]
            },
            "deniedNamespacePrefixes": {
              "type": "array",
              "description": "Namespace prefixes where the Provisioner may not manage tenant RBAC (release namespace is always denied)",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "kube-",
                "openshift-",
                "gke-",
                "eks-",
                "aws-",
                "aks-",
                "azure-"
              ]
            }
          }
        }
      }
    },
    "serviceAccountToken": {
      "type": "object",
      "description": "Projected ServiceAccount token configuration for operator pods",
      "additionalProperties": false,
      "properties": {
        "kubernetesAudience": {
          "type": "string",
          "description": "Audience for the projected Kubernetes API ServiceAccount token (`--api-audiences`)",
          "default": ""
        },
        "openBaoAudience": {
          "type": "string",
          "description": "Audience for projected OpenBao auth tokens mounted into the controller and executor Jobs",
          "minLength": 1,
          "default": "openbao-internal"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "description": "NetworkPolicy configuration for operator pods",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable NetworkPolicies for operator pod isolation",
          "default": true
        },
        "metricsAllowedNamespaceLabels": {
          "type": "object",
          "description": "Namespace labels required to access metrics endpoint",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "gatewayAPI": {
      "type": "object",
      "description": "Gateway API configuration",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable Gateway API RBAC permissions (httproutes, tlsroutes, backendtlspolicies)",
          "default": true
        }
      }
    }
  },
  "required": [
    "image",
    "tenancy"
  ],
  "$defs": {
    "resources": {
      "type": "object",
      "description": "Resource requests and limits",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "envVars": {
      "type": "array",
      "description": "Additional environment variables",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "nodeSelector": {
      "type": "object",
      "description": "Node selector for pod scheduling",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "description": "Tolerations for pod scheduling",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "enum": [
              "Exists",
              "Equal"
            ]
          },
          "value": {
            "type": "string"
          },
          "effect": {
            "type": "string",
            "enum": [
              "NoSchedule",
              "PreferNoSchedule",
              "NoExecute"
            ]
          },
          "tolerationSeconds": {
            "type": "integer"
          }
        }
      }
    },
    "affinity": {
      "type": "object",
      "description": "Affinity rules for pod scheduling",
      "properties": {
        "nodeAffinity": {
          "type": "object"
        },
        "podAffinity": {
          "type": "object"
        },
        "podAntiAffinity": {
          "type": "object"
        }
      }
    },
    "annotations": {
      "type": "object",
      "description": "Annotations to add",
      "additionalProperties": {
        "type": "string"
      }
    },
    "labels": {
      "type": "object",
      "description": "Labels to add",
      "additionalProperties": {
        "type": "string"
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "description": "Container security context",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "add": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsUser": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "description": "Pod security context",
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "fsGroup": {
          "type": "integer"
        },
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RuntimeDefault",
                "Localhost",
                "Unconfined"
              ]
            },
            "localhostProfile": {
              "type": "string"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "description": "Service account configuration",
      "properties": {
        "annotations": {
          "$ref": "#/$defs/annotations"
        }
      }
    }
  }
}
