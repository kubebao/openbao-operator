# Refresh runtime pins with make update-operator-upgrade-baseline BASELINE_VERSION=X.Y.Z.
# Release qualification checks the previous published stable release and its provenance.
OPERATOR_UPGRADE_BASELINE=0.6.1
OPERATOR_UPGRADE_BASELINE_CHART=oci://ghcr.io/kubebao/charts/openbao-operator
OPERATOR_UPGRADE_BASELINE_CHART_DIGEST=sha256:03bc763ade61590f3616bff2738b379453554084cee12aa61035503c3d9fc338
# Keep the approved API migration fixture pair separate from the runtime baseline.
OPERATOR_UPGRADE_MIGRATION_BASELINE=0.5.0
OPERATOR_UPGRADE_MIGRATION_TARGET=0.5.1
# Preserve the legacy CREATE contract used to seed existing Shared-mode resources.
OPERATOR_UPGRADE_LEGACY_SEED=0.5.3
OPERATOR_UPGRADE_LEGACY_SEED_INIT_IMAGE=ghcr.io/kubebao/openbao-init@sha256:9298ef4eceaec7ae79de2d7429261b5d60c1488319033f76bbdb48995bdf10c7
OPERATOR_UPGRADE_BASELINE_INIT_IMAGE=ghcr.io/kubebao/openbao-init@sha256:190fde3ba6c4b8e48ed39f82fde61273953f30c4fd79784e0f59802f06314ed9
OPERATOR_UPGRADE_BASELINE_MANAGER_IMAGE=ghcr.io/kubebao/openbao-operator@sha256:8a73e5a7c0f13d6786e7ca6d65af20cb36620d4464dc07a6e8210e59d17bcb97
OPERATOR_UPGRADE_TARGET_RELEASE=0.7.0
# The 0.7 line serves kubebao.org instead of openbao.org, so the candidate
# cannot upgrade the baseline in place. While this is set, the job establishes
# the digest-pinned baseline and then moves it to the candidate with the
# api-migration command. Remove this setting and refresh the fixtures after
# 0.7.0 becomes the baseline.
OPERATOR_UPGRADE_API_MIGRATION_SOURCE=0.6.1
